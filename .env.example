# Public API base URL used by services
# Leave empty to default to the current site origin.
VITE_API_URL=
NEXT_PUBLIC_API_URL=

# Public WebSocket URL used by trading
VITE_WS_URL=ws://localhost:8085
NEXT_PUBLIC_WS_URL=ws://localhost:8085
TRADING_PORT=8085
TRADING_SERVER_URL=http://localhost:8085

# Optional wallet exchange rate seed
VITE_USD_KES_RATE=129.5
NEXT_PUBLIC_USD_KES_RATE=129.5

# Auth API settings
AUTH_API_PORT=8090
SUPABASE_DB_URL=postgresql://postgres:your_password@db.your_project_ref.supabase.co:5432/postgres
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=8h
PASSWORD_RESET_TOKEN_MINUTES=30

# Super admin bootstrap
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@probinary.com
BOOTSTRAP_SUPER_ADMIN_USERNAME=superadmin
BOOTSTRAP_SUPER_ADMIN_PASSWORD=your_superadmin_password

# Supabase settings
SUPABASE_URL=https://your_project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your_project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Paystack settings
PAYSTACK_SECRET_KEY=your_paystack_secret_key
VITE_PAYSTACK_PUBLIC_KEY=your_paystack_public_key
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your_paystack_public_key

# NOWPayments crypto (server-side only)
NOWPAYMENTS_API_KEY=your_nowpayments_api_key
NOWPAYMENTS_IPN_SECRET=your_nowpayments_ipn_secret
APP_BASE_URL=https://your-public-site.example

# MakamescoPay M-Pesa STK Push (server-side only)
MAKAMESCOPAY_API_KEY=your_makamescopay_secret_key
USD_KES_RATE=129.5
