{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/sync-deployment-dashboard.js",
  "outputDirectory": "www.probinary.site",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...path]" },
    { "source": "/api", "destination": "/api/index" }
  ]
}