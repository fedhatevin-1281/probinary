  <script>
    (function() {
      let currentUser = null;
      try {
        currentUser = JSON.parse(localStorage.getItem('probinary_user') || '{}');
      } catch (e) {}

      if (currentUser && currentUser.name) {
        document.getElementById('sidebarUserName').textContent = currentUser.name;
        document.getElementById('sidebarUserEmail').textContent = currentUser.email || 'admin@probinary.com';
        const initial = currentUser.name.charAt(0).toUpperCase();
        document.getElementById('sidebarAvatar').textContent = initial;
        document.getElementById('headerAvatarBtn').textContent = initial;
      }

      function adminFetch(url, options = {}) {
        const headers = { ...(options.headers || {}) };
        const token = localStorage.getItem('auth_token');
        if (token) headers.Authorization = `Bearer ${token}`;
        return fetch(url, { ...options, headers });
      }

      window.switchAdminTab = function(tabId) {
        const tabs = ['users', 'withdrawals', 'kyc', 'adjustments', 'deposits', 'transactions', 'trades'];
        tabs.forEach(t => {
          const btn = document.getElementById('tabBtn' + t.charAt(0).toUpperCase() + t.slice(1));
          const panel = document.getElementById('panel' + t.charAt(0).toUpperCase() + t.slice(1));
          if (btn && panel) {
            if (t === tabId) {
              btn.classList.add('active');
              panel.style.display = 'flex';
            } else {
              btn.classList.remove('active');
              panel.style.display = 'none';
            }
          }
        });
      };

      let cachedUsers = [];
      let cachedWithdrawals = [];
      let cachedKyc = [];
      let cachedTransactions = [];
      let activeKycSubmission = null;
      let targetAdjUserId = null;

      window.openModal = function(id) {
        const el = document.getElementById(id);
        if (el) el.style.display = 'flex';
      };
      window.closeModal = function(id) {
        const el = document.getElementById(id);
        if (el) el.style.display = 'none';
      };

      // 1. REFRESH ADMIN DATA
      window.refreshAdminData = async function() {
        try {
          const [overviewRes, wdRes, depRes, usersRes, kycRes, txRes, tradesRes] = await Promise.all([
            adminFetch('/api/admin/overview').then(r => r.json()).catch(() => ({})),
            adminFetch('/api/admin/withdrawals').then(r => r.json()).catch(() => ({})),
            adminFetch('/api/admin/deposits').then(r => r.json()).catch(() => ({})),
            adminFetch('/api/admin/users').then(r => r.json()).catch(() => ({})),
            adminFetch('/api/admin/kyc/queue').then(r => r.json()).catch(() => ({})),
            adminFetch('/api/admin/transactions').then(r => r.json()).catch(() => ({})),
            adminFetch('/api/admin/trades').then(r => r.json()).catch(() => ({}))
          ]);

          // Overview Stats
          if (overviewRes.stats) {
            const s = overviewRes.stats;
            document.getElementById('statTotalUsers').textContent = s.totalUsers || 0;
            document.getElementById('statActiveUsers').textContent = `${s.activeUsers || s.totalUsers || 0} active`;
            document.getElementById('statCompletedDeposits').textContent = '$' + (s.totalDepositsAmount || 0).toLocaleString(undefined, {minimumFractionDigits: 2});
            document.getElementById('statDepositsCount').textContent = `${s.totalDepositsCount || 0} tx`;
            document.getElementById('statPendingWithdrawals').textContent = '$' + (s.pendingWithdrawalsAmount || 0).toLocaleString(undefined, {minimumFractionDigits: 2});
            document.getElementById('statPendingWdCount').textContent = `${s.pendingWithdrawalsCount || 0} requests`;
            document.getElementById('tabCountWd').textContent = s.pendingWithdrawalsCount || 0;
            document.getElementById('statKycReviewCount').textContent = s.pendingKycCount || 0;
            document.getElementById('tabCountKyc').textContent = s.pendingKycCount || 0;
            document.getElementById('statKycApprovedCount').textContent = `${s.approvedKycCount || 0} approved`;
            document.getElementById('sidebarBalanceAmount').textContent = '$' + (s.totalWalletBalances || 0).toLocaleString(undefined, {minimumFractionDigits: 2});
          }

          // Users Table
          if (usersRes.users) {
            cachedUsers = usersRes.users;
            renderUsersTable(cachedUsers);
            populateUserDropdown(cachedUsers);
          }

          // Withdrawals Table
          if (wdRes.withdrawals) {
            cachedWithdrawals = wdRes.withdrawals;
            renderWithdrawalsTable(cachedWithdrawals);
          }

          // KYC Table
          if (kycRes.queue || kycRes.submissions) {
            cachedKyc = kycRes.queue || kycRes.submissions || [];
            renderKycTable(cachedKyc);
          }

          // Deposits Table
          if (depRes.deposits) {
            renderDepositsTable(depRes.deposits);
          }

          // Transactions Table
          if (txRes.transactions) {
            cachedTransactions = txRes.transactions;
            renderTransactionsTable(cachedTransactions);
            renderAdjustmentsTable(cachedTransactions.filter(t => t.transaction_type === 'adjustment'));
          }

          // Trades Table
          if (tradesRes.trades) {
            renderTradesTable(tradesRes.trades);
          }

        } catch (e) {
          console.error('Failed refreshing admin data:', e);
        }
      };

      // 2. RENDER USERS
      function renderUsersTable(users) {
        const tbody = document.getElementById('usersTableBody');
        if (!users || users.length === 0) {
          tbody.innerHTML = `<tr><td colspan="10" style="text-align: center; padding: 24px; color: var(--text-gray);">No users found.</td></tr>`;
          return;
        }

        tbody.innerHTML = users.map(u => {
          const isActive = u.accountStatus === 'active';
          const statusBadge = isActive
            ? `<span style="padding: 2px 7px; border-radius: 4px; background: rgba(16,185,129,0.15); color: var(--accent-green); font-size: 10px; font-weight: 700;">Active</span>`
            : `<span style="padding: 2px 7px; border-radius: 4px; background: rgba(239,68,68,0.15); color: var(--accent-red); font-size: 10px; font-weight: 700;">Suspended</span>`;

          const kycBadge = u.kycStatus === 'approved' || u.kycStatus === 'verified'
            ? `<span style="color: var(--accent-green); font-weight: 700; font-size: 11px;">● Tier 2 Verified</span>`
            : (u.kycStatus === 'rejected'
              ? `<span style="color: var(--accent-red); font-weight: 700; font-size: 11px;">● Rejected</span>`
              : `<span style="color: var(--accent-gold); font-weight: 600; font-size: 11px;">● Pending</span>`);

          const dateStr = u.createdAt ? new Date(u.createdAt).toLocaleDateString() : 'Active';

          return `
            <tr>
              <td class="mono" style="color: var(--accent-lavender); font-weight: 700;">#${u.id}</td>
              <td style="font-weight: 700; color: #fff;">${u.name}</td>
              <td class="mono" style="font-size: 11px; color: #baa4e8;">${u.email}</td>
              <td>${statusBadge}</td>
              <td class="mono" style="font-weight: 800; color: #fff;">$${(Number(u.balance)||0).toLocaleString(undefined, {minimumFractionDigits: 2})}</td>
              <td class="mono" style="color: var(--accent-green); font-weight: 600;">$${(Number(u.totalDeposits)||0).toLocaleString(undefined, {minimumFractionDigits: 2})}</td>
              <td class="mono" style="color: var(--text-gray);">$${(Number(u.totalWithdrawals)||0).toLocaleString(undefined, {minimumFractionDigits: 2})}</td>
              <td>${kycBadge}</td>
              <td style="font-size: 11px; color: var(--text-gray);">${dateStr}</td>
              <td style="text-align: right;">
                <div style="display: flex; gap: 4px; justify-content: flex-end;">
                  <button onclick="openBalanceModal(${u.id}, '${u.email}', ${u.balance})" class="btn-action" style="font-size: 10px; padding: 2px 8px;">
                    Adjust Bal
                  </button>
                  <button onclick="toggleUserStatus(${u.id}, '${u.accountStatus}')" class="btn-action" style="font-size: 10px; padding: 2px 6px; color: ${isActive ? 'var(--accent-red)' : 'var(--accent-green)'};">
                    ${isActive ? 'Suspend' : 'Activate'}
                  </button>
                </div>
              </td>
            </tr>
          `;
        }).join('');
      }

      window.filterUsersTable = function() {
        const query = document.getElementById('userSearchInput').value.trim().toLowerCase();
        if (!query) return renderUsersTable(cachedUsers);
        const filtered = cachedUsers.filter(u =>
          String(u.id).includes(query) ||
          (u.email && u.email.toLowerCase().includes(query)) ||
          (u.name && u.name.toLowerCase().includes(query))
        );
        renderUsersTable(filtered);
      };

      window.toggleUserStatus = async function(userId, currentStatus) {
        const newStatus = currentStatus === 'active' ? 'suspended' : 'active';
        if (!confirm(`Are you sure you want to mark User #${userId} as ${newStatus}?`)) return;
        try {
          const res = await adminFetch(`/api/admin/users/${userId}/status`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: newStatus })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            alert(data.message || 'Status updated successfully.');
            refreshAdminData();
          } else {
            alert(data.error || 'Failed to update user status.');
          }
        } catch {
          alert('Error connecting to server.');
        }
      };

      // 3. WITHDRAWALS
      function renderWithdrawalsTable(withdrawals) {
        const tbody = document.getElementById('withdrawalsTableBody');
        if (!withdrawals || withdrawals.length === 0) {
          tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; padding: 24px; color: var(--text-gray);">No withdrawal requests recorded.</td></tr>`;
          return;
        }

        tbody.innerHTML = withdrawals.map(w => {
          const isPending = w.status === 'pending';
          const isApproved = w.status === 'approved' || w.status === 'processing';
          const isCompleted = w.status === 'completed';
          const isRejected = w.status === 'rejected' || w.status === 'failed';

          let statusBadge = `<span style="padding: 2px 8px; border-radius: 4px; background: rgba(251,191,36,0.15); color: var(--accent-gold); font-size: 10px; font-weight: 700; border: 1px solid rgba(251,191,36,0.3);">● Pending</span>`;
          if (isCompleted) {
            statusBadge = `<span style="padding: 2px 8px; border-radius: 4px; background: rgba(16,185,129,0.15); color: var(--accent-green); font-size: 10px; font-weight: 700; border: 1px solid rgba(16,185,129,0.3);">Completed</span>`;
          } else if (isApproved) {
            statusBadge = `<span style="padding: 2px 8px; border-radius: 4px; background: rgba(168,85,247,0.15); color: var(--accent-lavender); font-size: 10px; font-weight: 700; border: 1px solid rgba(168,85,247,0.3);">Approved (Clearing)</span>`;
          } else if (isRejected) {
            statusBadge = `<span style="padding: 2px 8px; border-radius: 4px; background: rgba(239,68,68,0.15); color: var(--accent-red); font-size: 10px; font-weight: 700; border: 1px solid rgba(239,68,68,0.3);">Rejected & Refunded</span>`;
          }

          let actions = `<span style="color: var(--text-gray); font-size: 11px;">Finalized</span>`;
          if (isPending) {
            actions = `
              <div style="display: flex; gap: 4px; justify-content: flex-end;">
                <button onclick="reviewWithdrawal('${w.id}', 'approve', ${w.amount})" class="btn-approve">Approve</button>
                <button onclick="reviewWithdrawal('${w.id}', 'reject', ${w.amount})" class="btn-reject">Reject</button>
              </div>
            `;
          } else if (isApproved) {
            actions = `
              <div style="display: flex; gap: 4px; justify-content: flex-end;">
                <button onclick="reviewWithdrawal('${w.id}', 'complete', ${w.amount})" class="btn-approve" style="background: var(--accent-purple); color: #fff;">Mark Paid</button>
                <button onclick="reviewWithdrawal('${w.id}', 'fail', ${w.amount})" class="btn-reject">Fail/Refund</button>
              </div>
            `;
          }

          const dateStr = w.createdAt ? new Date(w.createdAt).toLocaleString(undefined, { dateStyle: 'short', timeStyle: 'short' }) : 'N/A';

          return `
            <tr>
              <td class="mono" style="color: var(--accent-lavender); font-weight: 700;">${w.id}</td>
              <td>
                <div style="font-weight: 700; color: #fff;">${w.userName}</div>
                <div class="mono" style="font-size: 10px; color: var(--text-gray);">${w.userEmail}</div>
              </td>
              <td><span style="font-weight: 600;">${w.method}</span></td>
              <td class="mono" style="font-weight: 800; font-size: 13px; color: #fff;">$${(Number(w.amount)||0).toFixed(2)}</td>
              <td class="mono" style="font-size: 11px; color: var(--text-gray);">${w.destination}</td>
              <td style="font-size: 11px; color: var(--text-gray);">${dateStr}</td>
              <td>${statusBadge}</td>
              <td style="text-align: right;">${actions}</td>
            </tr>
          `;
        }).join('');
      }

      window.filterWithdrawals = function(filter) {
        document.querySelectorAll('#panelWithdrawals .pill-btn').forEach(b => b.classList.remove('active'));
        const btn = document.getElementById('wdFilter' + filter.charAt(0).toUpperCase() + filter.slice(1));
        if (btn) btn.classList.add('active');

        if (filter === 'all') return renderWithdrawalsTable(cachedWithdrawals);
        const filtered = cachedWithdrawals.filter(w => {
          if (filter === 'pending') return w.status === 'pending';
          if (filter === 'approved') return w.status === 'approved' || w.status === 'processing';
          if (filter === 'completed') return w.status === 'completed';
          if (filter === 'rejected') return w.status === 'rejected' || w.status === 'failed';
          return true;
        });
        renderWithdrawalsTable(filtered);
      };

      window.reviewWithdrawal = async function(id, action, amount) {
        let note = null;
        if (action === 'reject' || action === 'fail') {
          note = prompt(`Enter reason for declining ${id} ($${Number(amount).toFixed(2)} will be refunded back to user):`, 'Document validation mismatch');
          if (!note) return;
        } else if (!confirm(`Confirm ${action.toUpperCase()} for withdrawal request ${id} ($${Number(amount).toFixed(2)})?`)) {
          return;
        }

        try {
          const res = await adminFetch(`/api/admin/withdrawals/${action}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, tradeId: id, action, reason: note, adminNote: note })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            alert(data.message || `Withdrawal ${action} confirmed!`);
            refreshAdminData();
          } else {
            alert(data.error || 'Failed to review withdrawal.');
          }
        } catch {
          alert('Network error connecting to server.');
        }
      };

      // 4. KYC VERIFICATION
      function renderKycTable(kycList) {
        const tbody = document.getElementById('kycTableBody');
        if (!kycList || kycList.length === 0) {
          tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; padding: 24px; color: var(--text-gray);">No KYC submissions recorded.</td></tr>`;
          return;
        }

        tbody.innerHTML = kycList.map(k => {
          const isPending = k.status === 'pending';
          const isApproved = k.status === 'approved' || k.status === 'verified';
          const statusPill = isApproved
            ? `<span style="padding: 2px 8px; border-radius: 4px; background: rgba(16,185,129,0.15); color: var(--accent-green); font-size: 10px; font-weight: 700;">Approved</span>`
            : (k.status === 'rejected'
              ? `<span style="padding: 2px 8px; border-radius: 4px; background: rgba(239,68,68,0.15); color: var(--accent-red); font-size: 10px; font-weight: 700;">Rejected</span>`
              : `<span style="padding: 2px 8px; border-radius: 4px; background: rgba(251,191,36,0.15); color: var(--accent-gold); font-size: 10px; font-weight: 700;">Pending Review</span>`);

          const submittedStr = k.createdAt ? new Date(k.createdAt).toLocaleDateString() : 'N/A';

          return `
            <tr>
              <td class="mono" style="color: var(--accent-lavender); font-weight: 700;">#${k.id || k.userId}</td>
              <td>
                <div style="font-weight: 700; color: #fff;">Trader #${k.userId}</div>
                <div class="mono" style="font-size: 10px; color: var(--text-gray);">${k.userEmail || ''}</div>
              </td>
              <td style="font-weight: 700; color: #fff;">${k.userName || 'Trader'}</td>
              <td>${k.docType || 'National ID'}</td>
              <td class="mono" style="color: var(--accent-lavender);">${k.docNumber || 'ID-DOC'}</td>
              <td style="font-size: 11px; color: var(--text-gray);">${submittedStr}</td>
              <td>${statusPill}</td>
              <td style="text-align: right;">
                <button onclick="inspectKyc(${k.id || k.userId})" class="btn-action" style="font-size: 11px; padding: 3px 8px;">
                  Inspect & Review →
                </button>
              </td>
            </tr>
          `;
        }).join('');
      }

      window.filterKyc = function(filter) {
        document.querySelectorAll('#panelKyc .pill-btn').forEach(b => b.classList.remove('active'));
        const btn = document.getElementById('kycFilter' + filter.charAt(0).toUpperCase() + filter.slice(1));
        if (btn) btn.classList.add('active');

        if (filter === 'all') return renderKycTable(cachedKyc);
        const filtered = cachedKyc.filter(k => {
          if (filter === 'pending') return k.status === 'pending';
          if (filter === 'approved') return k.status === 'approved' || k.status === 'verified';
          if (filter === 'rejected') return k.status === 'rejected';
          return true;
        });
        renderKycTable(filtered);
      };

      window.inspectKyc = function(id) {
        const item = cachedKyc.find(k => (k.id === id || k.userId === id));
        if (!item) return;
        activeKycSubmission = item;

        document.getElementById('modalKycUserTag').textContent = `Submission #${item.id || item.userId} · User #${item.userId}`;
        document.getElementById('modalKycName').textContent = item.userName || 'Trader';
        document.getElementById('modalKycDocType').textContent = item.docType || 'National ID';
        document.getElementById('modalKycDocNum').textContent = item.docNumber || 'N/A';
        document.getElementById('modalKycImgFront').src = item.frontUrl || 'https://probinary.app/docs/placeholder-front.png';
        document.getElementById('modalKycImgBack').src = item.backUrl || item.selfieUrl || 'https://probinary.app/docs/placeholder-back.png';
        document.getElementById('modalKycRejectionReason').value = item.rejectionReason || '';

        openModal('modalKycInspect');
      };

      window.submitKycAction = async function(action) {
        if (!activeKycSubmission) return;
        const reason = document.getElementById('modalKycRejectionReason').value.trim();
        if (action === 'reject' && !reason) {
          return alert('Please enter a rejection reason to inform the trader.');
        }

        try {
          const res = await adminFetch(`/api/admin/kyc/${action}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              kycId: activeKycSubmission.id,
              userId: activeKycSubmission.userId,
              action,
              reason,
              rejectionReason: reason
            })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            alert(data.message || `KYC submission marked as ${action.toUpperCase()}!`);
            closeModal('modalKycInspect');
            refreshAdminData();
          } else {
            alert(data.error || 'Failed to update KYC.');
          }
        } catch {
          alert('Network error connecting to server.');
        }
      };

      // 5. MANUAL ADJUSTMENTS & USER MODAL
      function populateUserDropdown(users) {
        const select = document.getElementById('adjUserSelect');
        if (!select) return;
        const prev = select.value;
        select.innerHTML = '<option value="">-- Choose User --</option>' + users.map(u => `
          <option value="${u.id}">${u.name} (${u.email}) - $${Number(u.balance).toFixed(2)}</option>
        `).join('');
        if (prev) select.value = prev;
      }

      window.onAdjUserSelected = function() {
        const select = document.getElementById('adjUserSelect');
        const uid = select.value;
        const user = cachedUsers.find(u => String(u.id) === String(uid));
        if (user) {
          document.getElementById('adjCurrentBalDisplay').textContent = '$' + Number(user.balance).toLocaleString(undefined, {minimumFractionDigits: 2});
        } else {
          document.getElementById('adjCurrentBalDisplay').textContent = '$0.00';
        }
      };

      window.submitManualAdjustment = async function() {
        const uid = document.getElementById('adjUserSelect').value;
        const amt = parseFloat(document.getElementById('adjAmountInput').value);
        const reason = document.getElementById('adjReasonInput').value.trim();
        const classify = document.getElementById('adjClassifyDeposit').checked;

        if (!uid) return alert('Please select a target user.');
        if (isNaN(amt) || amt <= 0) return alert('Please enter a valid amount greater than zero.');
        if (!reason) return alert('Please provide an audit note/reason for this adjustment.');

        try {
          const res = await adminFetch('/api/admin/balance/adjust', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId: uid, amount: amt, reason, classifyAsDeposit: classify })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            alert(data.message || 'Balance adjusted successfully!');
            document.getElementById('adjAmountInput').value = '';
            document.getElementById('adjReasonInput').value = '';
            refreshAdminData();
          } else {
            alert(data.error || 'Failed to adjust balance.');
          }
        } catch {
          alert('Network error submitting adjustment.');
        }
      };

      window.openBalanceModal = function(userId, email, balance) {
        targetAdjUserId = userId;
        document.getElementById('modalAdjUserLabel').textContent = userId ? `User #${userId}` : 'Custom Trader';
        document.getElementById('modalAdjEmailLabel').textContent = email || 'Search or select';
        document.getElementById('modalAdjCurrentBal').textContent = '$' + (Number(balance)||0).toFixed(2);
        document.getElementById('modalAdjAmount').value = '';
        document.getElementById('modalAdjReason').value = '';
        openModal('modalAdjustBalance');
      };

      window.submitModalAdjustment = async function() {
        if (!targetAdjUserId) return alert('No target user specified.');
        const amt = parseFloat(document.getElementById('modalAdjAmount').value);
        const reason = document.getElementById('modalAdjReason').value.trim();
        const classify = document.getElementById('modalAdjDeposit').checked;

        if (isNaN(amt) || amt <= 0) return alert('Please enter a valid credit amount.');

        try {
          const res = await adminFetch('/api/admin/balance/adjust', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              userId: targetAdjUserId,
              amount: amt,
              reason: reason || 'Admin manual balance adjustment',
              classifyAsDeposit: classify
            })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            alert(data.message || 'Balance updated successfully!');
            closeModal('modalAdjustBalance');
            refreshAdminData();
          } else {
            alert(data.error || 'Failed to adjust balance.');
          }
        } catch {
          alert('Network error submitting adjustment.');
        }
      };

      function renderAdjustmentsTable(adjustments) {
        const tbody = document.getElementById('adjustmentsTableBody');
        if (!tbody) return;
        if (!adjustments || adjustments.length === 0) {
          tbody.innerHTML = `<tr><td colspan="6" style="text-align: center; padding: 20px; color: var(--text-gray);">No adjustments recorded yet.</td></tr>`;
          return;
        }

        tbody.innerHTML = adjustments.slice(0, 50).map(a => {
          const dateStr = a.created_at ? new Date(a.created_at).toLocaleString(undefined, { dateStyle: 'short', timeStyle: 'short' }) : 'N/A';
          return `
            <tr>
              <td class="mono" style="color: var(--accent-lavender); font-weight: 700;">${a.payment_reference || ('ADJ-' + a.id)}</td>
              <td>${a.userEmail || ('User #' + a.user_id)}</td>
              <td class="mono" style="color: var(--accent-green); font-weight: 700;">+$${Number(a.amount).toFixed(2)}</td>
              <td>${a.description || 'Admin Balance Adjustment'}</td>
              <td>${a.metadata_json?.admin_id ? ('Admin #' + a.metadata_json.admin_id) : 'Admin'}</td>
              <td style="font-size: 11px; color: var(--text-gray);">${dateStr}</td>
            </tr>
          `;
        }).join('');
      }

      // 6. DEPOSITS
      function renderDepositsTable(deposits) {
        const tbody = document.getElementById('depositsTableBody');
        if (!deposits || deposits.length === 0) {
          tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; padding: 24px; color: var(--text-gray);">No deposits recorded.</td></tr>`;
          return;
        }

        let total = 0;
        tbody.innerHTML = deposits.map(d => {
          const amt = Number(d.amount) || 0;
          total += amt;
          const dateStr = d.createdAt ? new Date(d.createdAt).toLocaleString(undefined, { dateStyle: 'short', timeStyle: 'short' }) : 'N/A';
          return `
            <tr>
              <td class="mono" style="color: var(--accent-lavender); font-weight: 700;">${d.id}</td>
              <td>
                <div style="font-weight: 700; color: #fff;">${d.userName}</div>
                <div class="mono" style="font-size: 10px; color: var(--text-gray);">${d.userEmail}</div>
              </td>
              <td><span style="font-weight: 600; color: #fff;">${d.asset || d.method}</span></td>
              <td class="mono" style="font-weight: 800; color: var(--accent-green); font-size: 13px;">+$${amt.toFixed(2)}</td>
              <td class="mono" style="font-size: 11px; color: var(--accent-purple);">${d.txHash || 'CONFIRMED'}</td>
              <td class="mono" style="font-size: 11px; color: var(--text-gray);">${d.destination}</td>
              <td style="font-size: 11px; color: var(--text-gray);">${dateStr}</td>
              <td><span style="padding: 2px 7px; border-radius: 4px; background: rgba(16,185,129,0.15); color: var(--accent-green); font-size: 10px; font-weight: 700;">Completed</span></td>
            </tr>
          `;
        }).join('');

        const banner = document.getElementById('depositsTotalBanner');
        if (banner) banner.textContent = `Total: $${total.toLocaleString(undefined, {minimumFractionDigits: 2})}`;
      }

      // 7. TRANSACTIONS
      function renderTransactionsTable(transactions) {
        const tbody = document.getElementById('txTableBody');
        if (!tbody) return;
        if (!transactions || transactions.length === 0) {
          tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; padding: 24px; color: var(--text-gray);">No transactions found.</td></tr>`;
          return;
        }

        tbody.innerHTML = transactions.map(t => {
          const isDeposit = t.transaction_type === 'deposit' || t.transaction_type === 'mpesa_deposit' || t.transaction_type === 'adjustment';
          const isWd = t.transaction_type === 'withdrawal';
          const amt = Number(t.amount) || 0;
          const dateStr = t.created_at ? new Date(t.created_at).toLocaleString(undefined, { dateStyle: 'short', timeStyle: 'short' }) : 'N/A';

          return `
            <tr>
              <td class="mono" style="color: var(--text-gray);">#${t.id}</td>
              <td class="mono" style="color: var(--accent-lavender); font-weight: 700;">${t.payment_reference || 'N/A'}</td>
              <td>${t.userEmail || ('User #' + t.user_id)}</td>
              <td><span style="background: var(--bg-card-alt); border: 1px solid var(--border-card-alt); border-radius: 4px; padding: 2px 6px; font-size: 10px; font-weight: 700; color: var(--accent-lavender);">${t.transaction_type.toUpperCase()}</span></td>
              <td class="mono" style="font-weight: 700; color: ${isDeposit ? 'var(--accent-green)' : (isWd ? 'var(--accent-gold)' : '#fff')};">
                ${isDeposit ? '+' : (isWd ? '-' : '')}$${amt.toFixed(2)}
              </td>
              <td style="font-size: 11px; color: var(--text-gray);">${t.description || '-'}</td>
              <td style="font-size: 11px; color: var(--text-gray);">${dateStr}</td>
              <td><span style="padding: 2px 6px; border-radius: 4px; font-size: 10px; font-weight: 700; background: rgba(224,204,255,0.1); color: #fff;">${t.status.toUpperCase()}</span></td>
            </tr>
          `;
        }).join('');
      }

      window.filterTxTable = function() {
        const type = document.getElementById('txFilterType').value;
        const status = document.getElementById('txFilterStatus').value;

        let filtered = cachedTransactions;
        if (type !== 'all') filtered = filtered.filter(t => t.transaction_type === type);
        if (status !== 'all') {
          if (status === 'completed') filtered = filtered.filter(t => t.status === 'completed');
          else if (status === 'pending') filtered = filtered.filter(t => t.status === 'pending');
          else if (status === 'approved') filtered = filtered.filter(t => t.status === 'approved');
          else if (status === 'failed') filtered = filtered.filter(t => t.status === 'failed' || t.status === 'rejected');
        }
        renderTransactionsTable(filtered);
      };

      // 8. TRADING RECORDS
      function renderTradesTable(trades) {
        const tbody = document.getElementById('tradesTableBody');
        if (!tbody) return;
        if (!trades || trades.length === 0) {
          tbody.innerHTML = `<tr><td colspan="10" style="text-align: center; padding: 24px; color: var(--text-gray);">No trading records logged.</td></tr>`;
          return;
        }

        const banner = document.getElementById('tradesTotalBanner');
        if (banner) banner.textContent = `${trades.length} Trades Recorded`;

        tbody.innerHTML = trades.map(t => {
          const isWin = t.status === 'won' || t.result === 'won';
          const isLoss = t.status === 'lost' || t.result === 'lost';
          const p = Number(t.profit) || 0;
          const dateStr = t.settled_at || t.created_at ? new Date(t.settled_at || t.created_at).toLocaleString() : 'N/A';

          return `
            <tr>
              <td class="mono" style="color: var(--accent-lavender); font-weight: 700;">${t.trade_id}</td>
              <td>${t.userEmail || ('Trader #' + t.user_id)}</td>
              <td><b style="color: #fff;">${t.symbol}</b></td>
              <td>${t.contract_type || 'Rise/Fall'}</td>
              <td><span style="color: ${t.direction === 'rise' ? 'var(--accent-green)' : 'var(--accent-red)'}; font-weight: 700; text-transform: uppercase;">${t.direction}</span></td>
              <td class="mono">$${(Number(t.stake)||0).toFixed(2)}</td>
              <td class="mono">$${(Number(t.payout)||0).toFixed(2)}</td>
              <td class="mono" style="font-weight: 800; color: ${isWin ? 'var(--accent-green)' : (isLoss ? 'var(--accent-red)' : '#fff')};">
                ${p >= 0 ? '+' : ''}$${p.toFixed(2)}
              </td>
              <td><span style="font-size: 10px; font-weight: 800; color: ${isWin ? 'var(--accent-green)' : (isLoss ? 'var(--accent-red)' : 'var(--accent-gold)')};">${(t.status || 'OPEN').toUpperCase()}</span></td>
              <td style="font-size: 11px; color: var(--text-gray);">${dateStr}</td>
            </tr>
          `;
        }).join('');
      }

      window.toggleMobileDrawer = function() {
        const d = document.getElementById('mobileDrawer');
        const b = document.getElementById('drawerBackdrop');
        if (d.classList.contains('open')) {
          d.classList.remove('open');
          b.style.display = 'none';
        } else {
          d.classList.add('open');
          b.style.display = 'block';
        }
      };

      window.signOut = function() {
        localStorage.removeItem('auth_token');
        localStorage.removeItem('probinary_user');
        window.location.href = '/auth/login.html';
      };

      // Initial Data Fetch
      refreshAdminData();
      setInterval(refreshAdminData, 10000);
    })();
  </script>
</body>
</html>
