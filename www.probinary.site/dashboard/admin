<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no"/>
  <title>ProBinary — Admin Management Console</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
  <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --bg-main: #090514;
      --bg-header: #0d081c;
      --bg-card: #191131;
      --bg-card-alt: #130c27;
      --bg-input: #090514;
      --border-card: rgba(224, 204, 255, 0.12);
      --border-card-alt: rgba(224, 204, 255, 0.18);
      --border-accent: rgba(168, 85, 247, 0.35);
      --accent-purple: #a855f7;
      --accent-purple-hover: #c084fc;
      --accent-purple-dim: rgba(168, 85, 247, 0.16);
      --accent-lavender: #e0ccff;
      --accent-gradient: linear-gradient(135deg, #e0ccff, #a855f7);
      --accent-green: #10b981;
      --accent-green-dim: rgba(16, 185, 129, 0.15);
      --accent-red: #ef4444;
      --accent-red-hover: #f87171;
      --accent-gold: #fbbf24;
      --accent-gold-dim: rgba(251, 191, 36, 0.15);
      --text-white: #f5f0ff;
      --text-gray: #9d8ec2;
      --text-dim: #6b5b95;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      height: 100vh;
      max-height: 100vh;
      overflow: hidden;
      background: var(--bg-main);
      color: var(--text-white);
      font-family: 'Public Sans', system-ui, -apple-system, sans-serif;
      font-size: 13px;
    }

    .mono { font-family: 'IBM Plex Mono', monospace; }

    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: #3d236b; border-radius: 4px; }
    ::-webkit-scrollbar-thumb:hover { background: #583399; }

    /* Top Navigation */
    .top-nav {
      height: 44px;
      background: var(--bg-header);
      border-bottom: 1px solid var(--border-card);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 14px;
      z-index: 50;
      flex-shrink: 0;
    }

    /* Layout Grid */
    .app-layout {
      height: calc(100vh - 44px);
      max-height: calc(100vh - 44px);
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: 12px;
      padding: 10px 14px;
      overflow: hidden;
    }

    /* Cards */
    .card-panel {
      background: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: 12px;
    }

    .pill-btn {
      border: 1px solid var(--border-card-alt);
      background: var(--bg-card-alt);
      color: var(--text-gray);
      border-radius: 20px;
      padding: 5px 12px;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.15s ease;
      text-decoration: none;
      white-space: nowrap;
    }
    .pill-btn:hover {
      border-color: var(--accent-purple);
      color: #fff;
    }
    .pill-btn.active {
      background: rgba(168, 85, 247, 0.2);
      border-color: var(--accent-purple);
      color: var(--accent-lavender);
    }

    /* Sidebar Navigation Links */
    .nav-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 7px 10px;
      border-radius: 8px;
      color: var(--text-gray);
      text-decoration: none;
      font-weight: 600;
      font-size: 12px;
      transition: all 0.15s ease;
      cursor: pointer;
      background: transparent;
      border: none;
      width: 100%;
      text-align: left;
    }
    .nav-btn:hover {
      background: rgba(224, 204, 255, 0.06);
      color: #fff;
    }
    .nav-btn.active {
      background: rgba(168, 85, 247, 0.18);
      color: var(--accent-lavender);
      border: 1px solid rgba(168, 85, 247, 0.3);
    }
    .nav-svg {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 16px;
      height: 16px;
    }

    /* Action Buttons */
    .btn-approve {
      background: var(--accent-green);
      color: #090514;
      border: none;
      border-radius: 6px;
      padding: 4px 10px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: transform 0.15s, box-shadow 0.15s;
    }
    .btn-approve:hover {
      transform: translateY(-1px);
      box-shadow: 0 0 10px rgba(16, 185, 129, 0.4);
    }

    .btn-reject {
      background: transparent;
      border: 1px solid var(--accent-red);
      color: var(--accent-red);
      border-radius: 6px;
      padding: 4px 9px;
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: background 0.15s;
    }
    .btn-reject:hover {
      background: rgba(239, 68, 68, 0.15);
    }

    .btn-action {
      background: var(--bg-card-alt);
      border: 1px solid var(--border-accent);
      color: var(--accent-lavender);
      border-radius: 6px;
      padding: 4px 9px;
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .btn-action:hover {
      border-color: var(--accent-purple);
      color: #fff;
    }

    .purple-btn {
      background: var(--accent-gradient);
      color: #090514;
      border: none;
      border-radius: 6px;
      font-weight: 700;
      cursor: pointer;
      transition: opacity 0.15s;
    }
    .purple-btn:hover { opacity: 0.9; }

    /* Table */
    .ledger-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 12px;
    }
    .ledger-table th {
      text-align: left;
      padding: 9px 12px;
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-gray);
      background: var(--bg-card-alt);
      position: sticky;
      top: 0;
      z-index: 10;
      border-bottom: 1px solid var(--border-card);
    }
    .ledger-table td {
      padding: 10px 12px;
      border-bottom: 1px solid rgba(224, 204, 255, 0.05);
      vertical-align: middle;
    }
    .ledger-table tr:hover td {
      background: rgba(224, 204, 255, 0.03);
    }

    /* Modal Overlay */
    .modal-overlay {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(9, 5, 20, 0.85);
      backdrop-filter: blur(4px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      padding: 16px;
    }
    .modal-box {
      background: var(--bg-card);
      border: 1px solid var(--border-accent);
      border-radius: 14px;
      width: 100%;
      max-width: 580px;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
      display: flex;
      flex-direction: column;
    }

    /* Mobile Drawer */
    .mobile-drawer {
      position: fixed;
      top: 0;
      left: -280px;
      width: 280px;
      height: 100%;
      background: var(--bg-header);
      border-right: 1px solid var(--border-card);
      z-index: 100;
      transition: left 0.25s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 16px;
    }
    .mobile-drawer.open { left: 0; }
    .drawer-backdrop {
      position: fixed;
      top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(0,0,0,0.6);
      z-index: 90;
      display: none;
    }

    @media (max-width: 900px) {
      .app-layout {
        grid-template-columns: 1fr;
      }
      .sidebar-panel {
        display: none !important;
      }
    }
  </style>
</head>
<body>

  <!-- TOP HEADER -->
  <header class="top-nav">
    <div style="display: flex; align-items: center; gap: 10px;">
