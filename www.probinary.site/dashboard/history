            <div id="statVolume" class="mono" style="font-size: 22px; font-weight: 800; color: #fff; margin-top: 4px;">$1,420.00</div>
            <div style="font-size: 10px; color: var(--text-gray); margin-top: 2px;">Cumulative turnover</div>
          </div>
        </div>

        <!-- FILTER & SEARCH BAR -->
        <div class="card-panel" style="padding: 10px 14px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
          <!-- Tabs -->
          <div style="display: flex; gap: 4px; overflow-x: auto;">
            <button class="filter-tab active" data-filter="all" onclick="filterCategory('all')">All Activity</button>
            <button class="filter-tab" data-filter="trade" onclick="filterCategory('trade')">Manual Trades</button>
            <button class="filter-tab" data-filter="bot" onclick="filterCategory('bot')">AI Bot Orders</button>
            <button class="filter-tab" data-filter="deposit" onclick="filterCategory('deposit')">Deposits</button>
            <button class="filter-tab" data-filter="withdraw" onclick="filterCategory('withdraw')">Withdrawals</button>
          </div>

          <!-- Search Input -->
          <div style="display: flex; align-items: center; background: var(--bg-card-alt); border: 1px solid var(--border-card-alt); border-radius: 8px; padding: 4px 10px; gap: 6px;">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--text-gray)" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input id="searchInput" oninput="applySearch()" type="text" placeholder="Filter by ID, asset, type..." class="mono" style="background: transparent; border: none; color: #fff; font-size: 11px; outline: none; width: 160px;"/>
          </div>
        </div>

        <!-- MAIN TABLE PANEL -->
        <div class="card-panel" style="padding: 14px; overflow-x: auto;">
          <table style="width: 100%; border-collapse: collapse; font-size: 11px; text-align: left; min-width: 650px;">
            <thead>
              <tr style="color: var(--text-gray); border-bottom: 1px solid var(--border-card);">
                <th style="padding: 8px 6px;">REF ID</th>
                <th>INSTRUMENT / RAIL</th>
                <th>CONTRACT</th>
                <th>STAKE</th>
                <th>OUTCOME</th>
                <th>PROFIT / LOSS</th>
                <th>TIMESTAMP</th>
              </tr>
            </thead>
            <tbody id="ledgerTableBody">
              <!-- Dynamically populated -->
            </tbody>
          </table>
        </div>

      </div>
    </main>
  </div>

  <script>
    (function() {
      let allRecords = [];
      let activeFilter = 'all';

      // Load balances
      const bal = parseFloat(localStorage.getItem('probinary_balance') || '10000.00');
      document.getElementById('headerBalanceText').textContent = '$' + bal.toFixed(2);
      document.getElementById('sidebarBalanceAmount').textContent = '$' + bal.toFixed(2);

      // User Profile Init
      try {
        const u = JSON.parse(localStorage.getItem('probinary_user') || '{}');
        if (u.name) {
          document.getElementById('sidebarUserName').textContent = u.name;
          document.getElementById('headerAvatarBtn').textContent = u.name.charAt(0).toUpperCase();
          document.getElementById('sidebarAvatar').textContent = u.name.charAt(0).toUpperCase();
        }
        if (u.email) document.getElementById('sidebarUserEmail').textContent = u.email;
      } catch (e) {}

      // Default benchmark records if empty
      const defaultRecords = [
        { id: 'PB-9421', asset: 'EUR/USD', type: 'Rise/Fall', stake: 25.00, outcome: 'WIN', profit: 21.75, time: 'Today 11:42:10' },
        { id: 'PB-9418', asset: 'BTC/USD', type: 'Over/Under', stake: 50.00, outcome: 'WIN', profit: 43.50, time: 'Today 11:38:05' },
        { id: 'WD-8841', asset: 'M-Pesa Payout', type: 'Withdrawal', stake: 50.00, outcome: 'COMPLETED', profit: -50.00, time: 'Today 10:24:19' },
        { id: 'DEP-7102', asset: 'M-Pesa STK', type: 'Deposit', stake: 100.00, outcome: 'CONFIRMED', profit: 100.00, time: 'Today 09:15:00' },
        { id: 'PB-9390', asset: 'GBP/USD', type: 'Rise/Fall', stake: 10.00, outcome: 'LOSS', profit: -10.00, time: 'Yesterday 17:12:44' },
        { id: 'PB-9388', asset: 'USD/JPY', type: 'Matches', stake: 10.00, outcome: 'WIN', profit: 8.70, time: 'Yesterday 16:55:01' },
        { id: 'PB-9382', asset: 'EUR/USD', type: 'Even/Odd', stake: 20.00, outcome: 'WIN', profit: 17.40, time: 'Yesterday 16:20:18' },
        { id: 'BOT-1044', asset: 'EUR/USD', type: 'AI Bot Order', stake: 100.00, outcome: 'WIN', profit: 87.00, time: 'Yesterday 14:05:12' },
        { id: 'PB-9370', asset: 'OIL/USD', type: 'Higher/Lower', stake: 25.00, outcome: 'LOSS', profit: -25.00, time: 'Yesterday 11:30:29' },
        { id: 'DEP-6991', asset: 'USDT TRC20', type: 'Deposit', stake: 500.00, outcome: 'CONFIRMED', profit: 500.00, time: 'Nov 8, 14:10' }
      ];

      window.loadLedger = function() {
        let stored = [];
        try {
          stored = JSON.parse(localStorage.getItem('probinary_trade_history') || '[]');
        } catch (e) {}

        allRecords = [...stored, ...defaultRecords];
        // Deduplicate by ID
        const seen = new Set();
        allRecords = allRecords.filter(r => {
          if (!r.id || seen.has(r.id)) return false;
          seen.add(r.id);
          return true;
        });

        calculateMetrics();
        renderTable(allRecords);
      };

      function calculateMetrics() {
        let total = 0;
        let wins = 0;
        let losses = 0;
        let netProfit = 0;
        let vol = 0;

        allRecords.forEach(r => {
          const type = (r.type || '').toLowerCase();
          const stake = parseFloat(r.stake) || 0;
          vol += stake;

          if (type.includes('rise') || type.includes('even') || type.includes('over') || type.includes('matches') || type.includes('touch') || type.includes('trade') || type.includes('bot')) {
            total++;
            const p = parseFloat(r.profit) || 0;
            netProfit += p;
            if (p > 0 || (r.outcome || '').toLowerCase() === 'win') wins++;
            else losses++;
          }
        });

        document.getElementById('statTotalTrades').textContent = total || '42';
        const rate = total > 0 ? ((wins / total) * 100).toFixed(1) : '66.7';
        document.getElementById('statWinRate').textContent = rate + '%';
        document.getElementById('statNetProfit').textContent = (netProfit >= 0 ? '+$' : '-$') + Math.abs(netProfit).toFixed(2);
        document.getElementById('statNetProfit').style.color = netProfit >= 0 ? 'var(--accent-green)' : 'var(--accent-red)';
        document.getElementById('statVolume').textContent = '$' + vol.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2});
      }

      function renderTable(list) {
        const tbody = document.getElementById('ledgerTableBody');
        tbody.innerHTML = '';

        if (list.length === 0) {
          tbody.innerHTML = `<tr><td colspan="7" style="text-align:center; padding:30px; color:var(--text-gray);">No records match your criteria.</td></tr>`;
          return;
        }

        list.forEach(r => {
          const tr = document.createElement('tr');
          tr.className = 'ledger-row';

          const outcomeStr = (r.outcome || 'SETTLED').toUpperCase();
          const p = parseFloat(r.profit) || 0;
          let outcomeColor = 'var(--text-gray)';
          let profitDisplay = '$' + Math.abs(p).toFixed(2);

          if (outcomeStr === 'WIN' || outcomeStr === 'COMPLETED' || outcomeStr === 'CONFIRMED' || outcomeStr === 'APPROVED') {
            outcomeColor = 'var(--accent-green)';
            if (p > 0) profitDisplay = `+$${p.toFixed(2)}`;
          } else if (outcomeStr === 'PENDING' || outcomeStr.includes('PENDING')) {
            outcomeColor = 'var(--accent-gold)';
            profitDisplay = `Pending Approval`;
          } else if (outcomeStr === 'LOSS' || outcomeStr === 'REJECTED') {
            outcomeColor = 'var(--accent-red)';
            profitDisplay = `-$${Math.abs(p).toFixed(2)}`;
          }

          tr.innerHTML = `
            <td style="padding: 10px 6px;" class="mono"><span style="color:#e0ccff; font-weight:700;">${r.id || '#PB-1000'}</span></td>
            <td><b style="color:#fff;">${r.asset || 'EUR/USD'}</b></td>
            <td><span style="background:var(--bg-card-alt); border:1px solid var(--border-card-alt); border-radius:4px; padding:2px 6px; font-size:10px; color:var(--accent-lavender);">${r.type || 'Rise/Fall'}</span></td>
            <td class="mono" style="color:#fff; font-weight:700;">$${(parseFloat(r.stake) || 10).toFixed(2)}</td>
            <td><span style="color:${outcomeColor}; font-weight:800; font-size:10px; letter-spacing:0.04em;">${outcomeStr}</span></td>
            <td class="mono" style="color:${p >= 0 ? 'var(--accent-green)' : 'var(--accent-red)'}; font-weight:700;">${profitDisplay}</td>
            <td style="color:var(--text-gray); font-size:10px;">${r.time || 'Recently'}</td>
          `;
          tbody.appendChild(tr);
        });
      }

      window.filterCategory = function(cat) {
        activeFilter = cat;
        document.querySelectorAll('.filter-tab').forEach(b => b.classList.remove('active'));
        if (event && event.target) event.target.classList.add('active');

        let filtered = allRecords;
        if (cat === 'trade') {
          filtered = allRecords.filter(r => !r.type.toLowerCase().includes('deposit') && !r.type.toLowerCase().includes('withdraw') && !r.type.toLowerCase().includes('bot'));
        } else if (cat === 'bot') {
          filtered = allRecords.filter(r => r.type.toLowerCase().includes('bot'));
        } else if (cat === 'deposit') {
          filtered = allRecords.filter(r => r.type.toLowerCase().includes('deposit'));
        } else if (cat === 'withdraw') {
          filtered = allRecords.filter(r => r.type.toLowerCase().includes('withdraw'));
        }
        renderTable(filtered);
      };

      window.applySearch = function() {
        const query = document.getElementById('searchInput').value.trim().toLowerCase();
        const res = allRecords.filter(r => {
          return (r.id && r.id.toLowerCase().includes(query)) ||
                 (r.asset && r.asset.toLowerCase().includes(query)) ||
                 (r.type && r.type.toLowerCase().includes(query)) ||
                 (r.outcome && r.outcome.toLowerCase().includes(query));
        });
        renderTable(res);
      };

      window.exportCSV = function() {
        let csv = 'RefID,Asset,Type,Stake,Outcome,Profit,Timestamp\n';
        allRecords.forEach(r => {
          csv += `"${r.id}","${r.asset}","${r.type}",${r.stake},"${r.outcome}",${r.profit},"${r.time}"\n`;
        });
        const blob = new Blob([csv], { type: 'text/csv' });
        const url = window.URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `ProBinary_Ledger_${new Date().toISOString().slice(0, 10)}.csv`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
      };

      window.toggleMobileDrawer = function() {
        const d = document.getElementById('mobileDrawer');
        const b = document.getElementById('drawerBackdrop');
        if (d.classList.contains('open')) {
          d.classList.remove('open');
          b.style.display = 'none';
        } else {
          d.classList.add('open');
          b.style.display = 'block';
        }
      };

      window.signOut = function() {
        localStorage.removeItem('auth_token');
        localStorage.removeItem('probinary_user');
        window.location.href = '/auth/login.html';
      };

      loadLedger();
    })();
  </script>
</body>
</html>
